{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Node runs these files through type stripping, which can only erase - so anything it
       can't erase (enums, namespaces, parameter properties) must fail at compile time too. */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Checking only. The build config below emits; the specs import `./index.ts` directly,
       which is only legal without emit. */
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
